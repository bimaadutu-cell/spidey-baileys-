{
  "name": "nextjs-postgresql-template",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node -e \"const fs=require('fs'); for (const p of ['src/app/layout.tsx','src/app/shell.tsx','src/app/perf.tsx']) { if (!fs.existsSync(p)) { console.error('MISSING '+p); process.exit(1);} } console.log('prebuild ok');\"",
    "build": "next build --webpack",
    "start": "node scripts/db-push.mjs && next start",
    "start:next": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "start:standalone": "node scripts/db-push.mjs && node server.js",
    "db:push": "node scripts/db-push.mjs",
    "db:drizzle": "drizzle-kit push"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "^0.35.5",
    "zod": "^4.6.5",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
